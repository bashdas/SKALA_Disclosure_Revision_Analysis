# 데이터 공급원: mock(기본, 가상 데이터) | live(OpenDART 실조회 + 로컬 파일 캐시)
DATA_BACKEND=mock
MCP_HOST=127.0.0.1          # Docker 내부망에서는 0.0.0.0
MCP_PORT=8100
LOG_LEVEL=INFO

# ── live 전용 ──
# OpenDART 인증키(영문·숫자 40자). 이 파일이 아니라 프로젝트 .env에만 넣고, 커밋·공유하지 마세요.
OPENDART_API_KEY=
# 원문 ZIP·파싱·메타·고유번호 파일 캐시 위치 (Mac 로컬: 프로젝트 기준 상대 경로, .gitignore의 data/)
DART_DATA_DIR=./data/dart
DART_MAX_CONCURRENCY=2              # 1~8
DART_TIMEOUT_SECONDS=30
DART_RATE_LIMIT_COOLDOWN_SECONDS=300  # 020/HTTP 429 이후 OpenDART 호출을 막는 시간
DART_CORP_CODE_TTL_HOURS=24         # corpCode.xml 재다운로드 주기
DART_FIND_MAX_PAGES=30              # 접수번호 단건 조회 시 하루 목록을 훑는 최대 페이지(100건/페이지)
# DART_BASE_URL=https://opendart.fss.or.kr   # 로컬 재생 검증(scripts/e2e_http.py)에서만 127.0.0.1로 바꿈

# PostgreSQL 저장소는 아직 미구현 (get_analysis_memo는 live에서 NOT_IMPLEMENTED)
DATABASE_URL=
