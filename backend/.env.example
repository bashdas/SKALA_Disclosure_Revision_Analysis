# Docker Compose services, including ai-worker. Local AI execution uses ai/.env.
# Keep real credentials in .env; never copy them into .env.example.
ENVIRONMENT=local

# PostgreSQL: Compose credentials and the sync SQLAlchemy connection URL.
# URL-encode special characters in the password used inside DATABASE_URL.
POSTGRES_USER=disclosure
POSTGRES_PASSWORD=local-postgres-change-me
POSTGRES_DB=disclosure
DATABASE_URL=postgresql+psycopg://disclosure:local-postgres-change-me@postgres:5432/disclosure
DATABASE_CONNECT_TIMEOUT=3

# Business API / JWT. Replace secret placeholders locally.
BUSINESS_API_PORT=8080
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
MEMO_UPLOAD_MAX_BYTES=5242880
SSE_POLL_INTERVAL_SECONDS=1
SSE_HEARTBEAT_SECONDS=15

# Shared by Business API and Business MCP; use the same random internal secret.
# Replace before running: at least 32 UTF-8 bytes and must not start with change-me.
INTERNAL_API_KEY=change-me-in-production
INTERNAL_REPORT_SAVE_MAX_ATTEMPTS=3

# RabbitMQ: credentials, queues, consumer retry topology and producer retry.
RABBITMQ_DEFAULT_USER=disclosure
RABBITMQ_DEFAULT_PASS=local-rabbitmq-change-me
RABBITMQ_URL=amqp://disclosure:local-rabbitmq-change-me@rabbitmq:5672/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=analysis.exchange
RABBITMQ_ANALYSIS_QUEUE=analysis.tasks
RABBITMQ_ANALYSIS_RETRY_QUEUE=analysis.tasks.retry
RABBITMQ_ANALYSIS_DLQ=analysis.tasks.dlq
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_SECONDS=5
RABBITMQ_PUBLISH_MAX_ATTEMPTS=3
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=5

# Business MCP -> Business API adapter.
BUSINESS_API_BASE_URL=http://business-api:8080
BUSINESS_MCP_HOST=0.0.0.0
BUSINESS_MCP_PORT=8081
BUSINESS_MCP_REQUEST_TIMEOUT_SECONDS=30

# External MCP: official OpenDART and Google Scholar via SerpApi.
OPENDART_API_KEY=
OPENDART_BASE_URL=https://opendart.fss.or.kr/api
OPENDART_MAX_DOWNLOAD_BYTES=20971520
OPENDART_METADATA_MAX_PAGES=100
SERPAPI_API_KEY=
EXTERNAL_MCP_HOST=0.0.0.0
EXTERNAL_MCP_PORT=8083
EXTERNAL_MCP_REQUEST_TIMEOUT_SECONDS=30

# RAG source acquisition uses MCP only. URLs are Compose-internal defaults.
BUSINESS_MCP_URL=http://business-mcp:8081/mcp
EXTERNAL_MCP_URL=http://external-mcp:8083/mcp
RAG_MCP_HOST=0.0.0.0
RAG_MCP_PORT=8082
RAG_MCP_REQUEST_TIMEOUT_SECONDS=60
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=100
RAG_MIN_SIMILARITY=0.6
RAG_EMBEDDING_MODEL=text-embedding-3-small
# Shared by RAG embeddings and the Docker ai-worker.
# Shell environment variables override .env during Compose interpolation.
# If a previous key is exported, run: unset OPENAI_API_KEY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# LangSmith tracing for the Docker ai-worker. Enable after setting the API key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=disclosure-ai-dev
# Set the endpoint to match your LangSmith region if needed.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# 시황 뉴스 수집과 보관
NEWS_COLLECTION_ENABLED=false
NEWS_COLLECTION_INTERVAL_SECONDS=3600
NEWS_RETENTION_DAYS=7
NEWS_CLASSIFICATION_MODEL=gpt-5.4-mini

# 별도 허용 계약이 없으면 실제 수집과 AI 이용을 활성화하지 않습니다.
NEWS_USAGE_AUTHORIZATION=
NAVER_API_PROVIDER=hub
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NEWS_IMPORTANT_RETENTION_DAYS=30
NEWS_UNRESOLVED_RETENTION_HOURS=48
NEWS_LOG_RETENTION_DAYS=14
NEWS_MAX_ARTICLES=50000
NEWS_MAX_STORAGE_BYTES=134217728
NEWS_INITIAL_HOURS=24
NEWS_OVERLAP_HOURS=2
NEWS_MAX_LOOKBACK_HOURS=72
NEWS_MAX_PAGES=3
NEWS_COMPANY_CALL_BUDGET=120
NEWS_MACRO_CALL_BUDGET=30
NEWS_DAILY_CALL_BUDGET=6000
NEWS_TOPICS=["기준금리","원달러 환율","물가","국제유가 원자재","무역 관세","산업 정책 공급망"]
NEWS_COMPANY_ALIASES={}
NEWS_COMPANY_INDUSTRIES={}
NEWS_CLASSIFICATION_CONCURRENCY=2
NEWS_CLASSIFICATION_BATCH_SIZE=10
NEWS_CLASSIFICATION_MAX_BATCHES=20
NEWS_CLASSIFICATION_TOKEN_BUDGET=64000
NEWS_CLASSIFICATION_TOKENS=4000
NEWS_CLASSIFICATION_TIMEOUT_SECONDS=30
NEWS_CLASSIFICATION_RETRIES=1
NEWS_CLASSIFICATION_MAX_ATTEMPTS=3
NEWS_EMBEDDING_ENABLED=false
NEWS_STALE_HOURS=3
