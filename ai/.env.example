OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
BUSINESS_API_BASE_URL=http://127.0.0.1:8080
BUSINESS_MCP_URL=http://127.0.0.1:8081/mcp
EXTERNAL_MCP_URL=http://127.0.0.1:8083/mcp
RAG_MCP_URL=http://127.0.0.1:8082/mcp
AI_STATE_PATH=outputs/ai-state.sqlite
AI_INTERNAL_TOKEN=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=disclosure-ai-dev
# Set the endpoint to match your LangSmith region if needed.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
# Local worker: use the backend RabbitMQ credentials and host-published port.
# Example: amqp://disclosure:YOUR_PASSWORD@127.0.0.1:5672/
RABBITMQ_URL=
RABBITMQ_EXCHANGE=analysis.exchange
RABBITMQ_ANALYSIS_QUEUE=analysis.tasks
RABBITMQ_MAX_RETRIES=3


# 메모 ID와 버전에 연결할 리포트 JSON을 별도로 지정할 때 사용합니다.
# 생략하면 패키지에 포함된 삼성중공업 검증 리포트를 사용합니다.
# AI_RESEARCH_REPORTS_PATH=/absolute/path/research_reports.json
